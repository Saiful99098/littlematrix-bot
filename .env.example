# Copy this file to .env and fill in YOUR OWN values.
# NEVER share .env, never push it to GitHub, never zip it publicly.
# On Render these same names go in Dashboard -> Environment.
BOT_TOKEN=
QUOTEX_EMAIL=
QUOTEX_PASSWORD=
# sample = bundled sample file | live = fetch from Quotex (local PC)
# db = read signals + CHECKER from the candle database (Render)
DATA_MODE=sample
COLLECTOR_ENABLED=False
# Render only: public base URL of the web service, e.g.
# https://blue-fish-prime-bot.onrender.com — leave empty for polling (local PC).
WEBHOOK_URL=
# Render only: Postgres connection string (auto-set by render.yaml
# from the free Postgres database). Leave empty for local SQLite testing.
# PC collector: put the Render Postgres EXTERNAL Database URL here
# (Dashboard -> littlematrix-db -> Info -> External Database URL)
# so collect_to_db.py on your PC can write into the Render database.
DATABASE_URL=
# How many completed days the collector backfills on startup (Render test: 5).
BACKFILL_DAYS=5
